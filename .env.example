# QuantumForge RAG Bot - Environment Variables Template
# Copy this file to .env and fill in the values

# Required: Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Telegram Bot Token (for Telegram integration)
TELEGRAM_BOT_TOKEN=

# Environment
ENV=development

# Redis (use redis://redis:6379/0 for Docker)
REDIS_URL=redis://redis:6379/0

# Nested settings use double underscore delimiter
# Example: MODELS__GEMINI_MODEL=gemini-2.0-flash

# Model overrides (optional)
# MODELS__GEMINI_MODEL=gemini-2.0-flash
# MODELS__EMBEDDING_MODEL_PATH=nomic-ai/nomic-embed-text-v1.5

# Vector DB overrides (optional)
# VECTOR_DB__CHROMA_DB_PATH=data/chroma_storage
# VECTOR_DB__CHROMA_COLLECTION_NAME=quantum_knowledge

# RAG overrides (optional)
# RAG__TOP_K_RETRIEVAL=50
# RAG__TOP_K_RERANK=5
# RAG__USE_COLBERT=true
# RAG__USE_SEMANTIC_CACHE=true # Set to false to disable Redis cache completely
